# Server
PORT=3000

# PostgreSQL — used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rest_api_showcase"

# JWT — used for signing/verifying tokens (HS256)
JWT_SECRET=change-me-to-a-long-random-secret

# Redis
REDIS_HOST=localhost

# Kafka broker host (single entry; consumer/producer appends :9092/:9093/:9094)
KAFKA_HOST=localhost
